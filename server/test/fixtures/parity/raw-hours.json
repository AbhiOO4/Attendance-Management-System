{
  "_comment": "Golden cases for sumRawHours (exact durations summed, rounded once). Instants are UTC; workedHours is the per-session 2dp value that gets stored. Shared by the server and client suites.",
  "cases": [
    { "name": "three sessions of exactly 8h (the rounding bug: sum of rounded = 7.99)", "sessions": [
      { "checkIn": "2026-09-01T02:00:00Z", "checkOut": "2026-09-01T04:20:00Z", "workedHours": 2.33 },
      { "checkIn": "2026-09-01T04:20:00Z", "checkOut": "2026-09-01T06:40:00Z", "workedHours": 2.33 },
      { "checkIn": "2026-09-01T06:40:00Z", "checkOut": "2026-09-01T10:00:00Z", "workedHours": 3.33 }
    ], "expected": 8, "sumOfRounded": 7.99 },
    { "name": "three sessions that rounded UP (sum of rounded = 8.01)", "sessions": [
      { "checkIn": "2026-09-01T02:00:00Z", "checkOut": "2026-09-01T02:10:00Z", "workedHours": 0.17 },
      { "checkIn": "2026-09-01T02:10:00Z", "checkOut": "2026-09-01T02:20:00Z", "workedHours": 0.17 },
      { "checkIn": "2026-09-01T02:20:00Z", "checkOut": "2026-09-01T10:00:00Z", "workedHours": 7.67 }
    ], "expected": 8, "sumOfRounded": 8.01 },
    { "name": "single plain session", "sessions": [
      { "checkIn": "2026-09-01T03:00:00Z", "checkOut": "2026-09-01T12:30:00Z", "workedHours": 9.5 }
    ], "expected": 9.5, "sumOfRounded": 9.5 },
    { "name": "night shift across midnight", "sessions": [
      { "checkIn": "2026-09-01T16:00:00Z", "checkOut": "2026-09-02T02:00:00Z", "workedHours": 10 }
    ], "expected": 10, "sumOfRounded": 10 },
    { "name": "an open session adds nothing", "sessions": [
      { "checkIn": "2026-09-01T03:00:00Z", "checkOut": "2026-09-01T07:00:00Z", "workedHours": 4 },
      { "checkIn": "2026-09-01T08:00:00Z", "checkOut": null, "workedHours": 0 }
    ], "expected": 4, "sumOfRounded": 4 },
    { "name": "legacy session without Dates falls back to workedHours", "sessions": [
      { "checkIn": null, "checkOut": null, "workedHours": 3.5 }
    ], "expected": 3.5, "sumOfRounded": 3.5 },
    { "name": "a check-out before the check-in counts as 0", "sessions": [
      { "checkIn": "2026-09-01T08:00:00Z", "checkOut": "2026-09-01T07:00:00Z", "workedHours": 0 }
    ], "expected": 0, "sumOfRounded": 0 },
    { "name": "no sessions", "sessions": [], "expected": 0, "sumOfRounded": 0 }
  ]
}
